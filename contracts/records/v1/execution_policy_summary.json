{
  "$defs": {
    "EffectivePolicy": {
      "additionalProperties": false,
      "description": "The current server/project intersection a new run would be admitted under.\n\nInput IDs are limited to this project's records; model identities are omitted.",
      "properties": {
        "reference": {
          "$ref": "#/$defs/PolicyReference"
        },
        "project_policy_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Project Policy Revision",
          "type": "integer"
        },
        "exposure": {
          "enum": [
            "schema_aggregates",
            "selected_excerpts",
            "raw_project_content"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "allowed_tools": {
          "items": {
            "enum": [
              "inspect_project",
              "inspect_dataset",
              "list_artifacts",
              "read_artifact",
              "read_job",
              "run_audit",
              "generate_split",
              "seal_evaluation",
              "run_baseline",
              "read_evaluation",
              "ingest_evidence",
              "search_evidence",
              "read_evidence_span",
              "search_failures",
              "read_failure",
              "record_outcome",
              "reconcile_outcome",
              "validate_claims",
              "build_report",
              "verify_report",
              "replay_science",
              "read_memory"
            ],
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "material_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ResourceLimits"
        },
        "spend_ceiling_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spend Ceiling Usd"
        },
        "allow_reuse": {
          "title": "Allow Reuse",
          "type": "boolean"
        },
        "automatic_failure_recording": {
          "title": "Automatic Failure Recording",
          "type": "boolean"
        },
        "verify_reports": {
          "title": "Verify Reports",
          "type": "boolean"
        },
        "share_operator_messages": {
          "title": "Share Operator Messages",
          "type": "boolean"
        }
      },
      "required": [
        "reference",
        "project_policy_revision",
        "exposure",
        "allowed_tools",
        "material_ids",
        "artifact_ids",
        "limits",
        "spend_ceiling_usd",
        "allow_reuse",
        "automatic_failure_recording",
        "verify_reports",
        "share_operator_messages"
      ],
      "title": "EffectivePolicy",
      "type": "object"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "sha256"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "Values are required; E01 owns defaults and server/project intersections.",
      "properties": {
        "model_tokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "model_requests": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "tool_calls": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "coordinator_iterations": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Coordinator Iterations",
          "type": "integer"
        },
        "specialist_assignments": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Specialist Assignments",
          "type": "integer"
        },
        "specialist_concurrency": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Specialist Concurrency",
          "type": "integer"
        },
        "delegation_depth": {
          "maximum": 1,
          "minimum": 0,
          "title": "Delegation Depth",
          "type": "integer"
        },
        "review_rounds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Review Rounds",
          "type": "integer"
        },
        "scientific_attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Scientific Attempts",
          "type": "integer"
        },
        "active_seconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Active Seconds",
          "type": "integer"
        },
        "transient_retries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Transient Retries",
          "type": "integer"
        },
        "finalization_model_tokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Finalization Model Tokens",
          "type": "integer"
        },
        "finalization_scientific_attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Finalization Scientific Attempts",
          "type": "integer"
        }
      },
      "required": [
        "model_tokens",
        "model_requests",
        "tool_calls",
        "coordinator_iterations",
        "specialist_assignments",
        "specialist_concurrency",
        "delegation_depth",
        "review_rounds",
        "scientific_attempts",
        "active_seconds",
        "transient_retries",
        "finalization_model_tokens",
        "finalization_scientific_attempts"
      ],
      "title": "ResourceLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectivePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_available": {
      "title": "Agent Available",
      "type": "boolean"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "project_id",
    "policy",
    "agent_available",
    "unavailable_reason"
  ],
  "title": "ExecutionPolicySummary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/execution_policy_summary.json"
}
