{
  "additionalProperties": false,
  "description": "Exact retained PDFium text layer for one upstream page; never OCR or normalized.",
  "properties": {
    "source_artifact_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Source Artifact Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "has_text": {
      "title": "Has Text",
      "type": "boolean"
    },
    "text": {
      "maxLength": 1000000,
      "title": "Text",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Text Sha256",
      "type": "string"
    },
    "representation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Representation Sha256",
      "type": "string"
    },
    "extraction_version": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Extraction Version",
      "type": "string"
    }
  },
  "required": [
    "source_artifact_id",
    "source_sha256",
    "page",
    "page_count",
    "has_text",
    "text",
    "text_sha256",
    "representation_sha256",
    "extraction_version"
  ],
  "title": "EvidencePageText",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/evidence_page_text.json"
}
