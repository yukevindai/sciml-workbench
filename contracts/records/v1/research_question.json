{
  "$defs": {
    "AvailableEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "evidence_reference",
          "default": "evidence_reference",
          "title": "Contract",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "availability": {
          "const": "available",
          "title": "Availability",
          "type": "string"
        },
        "source_artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "representation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Representation Sha256",
          "type": "string"
        },
        "extraction_version": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Extraction Version",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/TextSpan"
        },
        "excerpt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Excerpt Sha256",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "availability",
        "source_artifact_id",
        "source_sha256",
        "representation_sha256",
        "extraction_version",
        "locator",
        "excerpt_sha256"
      ],
      "title": "AvailableEvidenceReference",
      "type": "object"
    },
    "MaterialQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "field": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "blocked_step_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Blocked Step Ids",
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "title": "Options",
          "type": "array"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "available": "#/$defs/AvailableEvidenceReference",
                "unavailable": "#/$defs/UnavailableEvidenceReference"
              },
              "propertyName": "availability"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AvailableEvidenceReference"
              },
              {
                "$ref": "#/$defs/UnavailableEvidenceReference"
              }
            ]
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "field",
        "prompt",
        "blocked_step_ids",
        "options",
        "evidence"
      ],
      "title": "MaterialQuestion",
      "type": "object"
    },
    "QuestionOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "consequence": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "consequence"
      ],
      "title": "QuestionOption",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_span",
          "default": "text_span",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "const": "unicode_codepoint",
          "default": "unicode_codepoint",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "UnavailableEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "evidence_reference",
          "default": "evidence_reference",
          "title": "Contract",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "availability": {
          "const": "unavailable",
          "title": "Availability",
          "type": "string"
        },
        "source_artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "source_artifact_id",
        "source_sha256",
        "reason"
      ],
      "title": "UnavailableEvidenceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "contract": {
      "const": "research_question",
      "default": "research_question",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Run Revision",
      "type": "integer"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/MaterialQuestion"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "answered",
        "superseded",
        "expired",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "answer_message_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Message Id"
    }
  },
  "required": [
    "id",
    "project_id",
    "created_at",
    "run_id",
    "revision",
    "run_revision",
    "questions",
    "status"
  ],
  "title": "ResearchQuestion",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/research_question.json"
}
