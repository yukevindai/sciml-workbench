{
  "$defs": {
    "ResearchStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "objective": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "allowed_input_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Input Ids",
          "type": "array"
        },
        "expected_artifact_kinds": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Artifact Kinds",
          "type": "array"
        },
        "completion_criteria": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Completion Criteria",
          "type": "array"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "blocked",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "action_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Action Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "objective",
        "depends_on",
        "allowed_input_ids",
        "expected_artifact_kinds",
        "completion_criteria",
        "status"
      ],
      "title": "ResearchStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "contract": {
      "const": "research_plan",
      "default": "research_plan",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ResearchStep"
      },
      "maxItems": 120,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "rationale_summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Rationale Summary",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "created_at",
    "run_id",
    "revision",
    "steps",
    "rationale_summary"
  ],
  "title": "ResearchPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/research_plan.json"
}
