{
  "$defs": {
    "AvailableEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "evidence_reference",
          "default": "evidence_reference",
          "title": "Contract",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "availability": {
          "const": "available",
          "title": "Availability",
          "type": "string"
        },
        "source_artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "representation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Representation Sha256",
          "type": "string"
        },
        "extraction_version": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Extraction Version",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/TextSpan"
        },
        "excerpt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Excerpt Sha256",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "availability",
        "source_artifact_id",
        "source_sha256",
        "representation_sha256",
        "extraction_version",
        "locator",
        "excerpt_sha256"
      ],
      "title": "AvailableEvidenceReference",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "classification": {
          "enum": [
            "computed_result",
            "source_supported",
            "interpretation",
            "hypothesis"
          ],
          "title": "Classification",
          "type": "string"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/AvailableEvidenceReference"
          },
          "title": "Source References",
          "type": "array"
        },
        "metric_references": {
          "items": {
            "$ref": "#/$defs/MetricReference"
          },
          "title": "Metric References",
          "type": "array"
        },
        "population": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "split_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split Id"
        },
        "limitations": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "uncertainty": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        },
        "reference_check": {
          "$ref": "#/$defs/ReferenceCheck"
        },
        "semantic_review": {
          "$ref": "#/$defs/SemanticReview"
        }
      },
      "required": [
        "id",
        "statement",
        "classification",
        "population",
        "limitations",
        "uncertainty",
        "reference_check",
        "semantic_review"
      ],
      "title": "Claim",
      "type": "object"
    },
    "MetricReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "field_path": {
          "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$",
          "title": "Field Path",
          "type": "string"
        },
        "partition": {
          "enum": [
            "train",
            "validation",
            "test",
            "excluded"
          ],
          "title": "Partition",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "units": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "artifact_id",
        "field_path",
        "partition",
        "value"
      ],
      "title": "MetricReference",
      "type": "object"
    },
    "ReferenceCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "valid",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "issues": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReferenceCheck",
      "type": "object"
    },
    "SemanticReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "conflicting",
            "not_reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Snapshot Sha256"
        },
        "reviewer_assignment_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Assignment Id"
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        }
      },
      "required": [
        "status"
      ],
      "title": "SemanticReview",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_span",
          "default": "text_span",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "const": "unicode_codepoint",
          "default": "unicode_codepoint",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "specialist_result",
      "default": "specialist_result",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "assignment_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Assignment Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Findings",
      "type": "array"
    },
    "supporting_artifact_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Supporting Artifact Ids",
      "type": "array"
    },
    "uncertainty": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Uncertainty",
      "type": "string"
    },
    "unresolved_issues": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Issues",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    }
  },
  "required": [
    "assignment_id",
    "findings",
    "supporting_artifact_ids",
    "uncertainty",
    "unresolved_issues",
    "recommended_actions"
  ],
  "title": "SpecialistResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/specialist_result.json"
}
