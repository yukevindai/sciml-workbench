          "type": "integer"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline_at": {
