{
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "waiting_for_job",
        "waiting_for_input",
        "paused",
        "completed",
        "partially_completed",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "artifact_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "stop_reason": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stop Reason"
    }
  },
  "required": [
    "run_id",
    "state",
    "artifact_ids",
    "stop_reason"
  ],
  "title": "RunResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/run_result.json"
}
