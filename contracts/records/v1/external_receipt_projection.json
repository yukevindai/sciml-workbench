{
  "additionalProperties": false,
  "properties": {
    "external_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "connector": {
      "const": "sciml-workbench",
      "title": "Connector",
      "type": "string"
    },
    "state": {
      "enum": [
        "prepared",
        "unknown",
        "confirmed"
      ],
      "title": "State",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "body_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Body Sha256",
      "type": "string"
    },
    "attempts": {
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Submitted At"
    },
    "external_project_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "External Project Id"
    },
    "external_record_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "External Record Id"
    },
    "artifact_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Artifact Id"
    },
    "reconciliation_required": {
      "title": "Reconciliation Required",
      "type": "boolean"
    }
  },
  "required": [
    "external_id",
    "connector",
    "state",
    "request_sha256",
    "body_sha256",
    "attempts",
    "submitted_at",
    "external_project_id",
    "external_record_id",
    "artifact_id",
    "reconciliation_required"
  ],
  "title": "ExternalReceiptProjection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciml-workbench.local/contracts/records/v1/external_receipt_projection.json"
}
