# FRONTEND Vercel project only; never NEXT_PUBLIC_ secrets.
WB_API_URL=https://YOUR-BACKEND.vercel.app
WB_API_TOKEN=replace-with-the-same-backend-api-token
WB_PUBLIC_ORIGIN=https://YOUR-FRONTEND.vercel.app
WB_REQUIRE_LOGIN=1
WB_LOGIN_USERNAME=kevin
WB_LOGIN_PASSWORD=replace-with-independent-32-plus-character-secret
WB_MAX_UPLOAD_BYTES=4194304
# Only if Vercel Deployment Protection is enabled on the backend:
WB_VERCEL_PROTECTION_BYPASS=
