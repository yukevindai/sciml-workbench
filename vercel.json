{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "*.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{frontend/**,backend/tests/**,docs/**,examples/**,.venv/**,outputs/**}"
    }
  },
  "crons": [
    {
      "path": "/internal/cron/dispatch",
      "schedule": "0 0 * * *"
    }
  ]
}
