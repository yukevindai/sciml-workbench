{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 800,
      "memory": 2048,
      "excludeFiles": "{frontend/**,backend/tests/**,docs/**,examples/**,.venv/**,outputs/**}"
    }
  },
  "crons": [
    {"path": "/internal/cron/science", "schedule": "* * * * *"},
    {"path": "/internal/cron/agent", "schedule": "* * * * *"},
    {"path": "/internal/cron/recovery", "schedule": "* * * * *"}
  ]
}
