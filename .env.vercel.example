# BACKEND Vercel project only. Managed PostgreSQL from Vercel Marketplace.
# Use a DIRECT connection: transaction-pooling endpoints cannot hold session locks.
WB_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
WB_DEPLOYMENT_MODE=vercel
# Set to 1 and redeploy only after setup/data migration finishes.
WB_SCHEDULER_ENABLED=0
WB_STORAGE_BACKEND=postgres
WB_STORAGE_ROOT=/tmp/sciml-workbench
WB_JOB_TIMEOUT_SECONDS=240
WB_MAX_UPLOAD_BYTES=4194304
WB_API_TOKEN=replace-with-independent-32-plus-character-secret
WB_EFM_USERNAME=workbench
WB_EFM_PASSWORD=replace-with-independent-32-plus-character-secret
CRON_SECRET=replace-with-independent-32-plus-character-secret
WB_AGENTS_ENABLED=0
# Enable only after following docs/agent-operator-guide.md.
WB_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
WB_COORDINATOR_MODEL=deepseek-chat
WB_SPECIALIST_MODEL=deepseek-chat
WB_AGENT_AUTO_POLICY=1
WB_AGENT_AUTO_SPEND_CEILING_USD=
WB_AGENT_MODEL_BOUNDS={}
WB_AGENT_MODEL_PRICES={}
WB_AGENT_LEASE_SECONDS=180
WB_AGENT_MAX_OUTPUT_TOKENS=1024
WB_PROVIDER_TIMEOUT_SECONDS=20
# Large Python bundle support if required by the installed scientific stack.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
