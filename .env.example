# Compose interpolation file: do not copy this whole file into frontend/.
# Generate independent URL-safe secrets: python -c 'import secrets; print(secrets.token_urlsafe(48))'
WB_API_TOKEN=replace-with-at-least-32-random-characters
WB_EFM_PASSWORD=replace-with-a-strong-random-password
WB_EFM_USERNAME=workbench
POSTGRES_PASSWORD=replace-with-a-random-database-password
WB_PUBLIC_ORIGIN=http://localhost:3000
# Local non-Docker development only (Compose overrides these):
WB_DATABASE_URL=postgresql+psycopg://workbench:replace-with-a-random-database-password@localhost:5432/workbench
WB_STORAGE_ROOT=./data
WB_STORAGE_BACKEND=local
WB_DEPLOYMENT_MODE=local
WB_API_URL=http://localhost:8000
WB_JOB_TIMEOUT_SECONDS=900
# Hosted frontend only: a single-operator password gate, not multi-user accounts.
# Production always requires login; WB_REQUIRE_LOGIN=0 applies only in development.
WB_REQUIRE_LOGIN=1
WB_LOGIN_USERNAME=workbench
WB_LOGIN_PASSWORD=replace-with-an-independent-16-plus-character-password

# Server-only agent settings. Manual tools need no model credentials.
# The assistant runs on DeepSeek by default (WB_MODEL_PROVIDER=anthropic is also supported).
# Get a key at https://platform.deepseek.com and keep it only in this server-side file.
WB_AGENTS_ENABLED=0
WB_MODEL_PROVIDER=deepseek
WB_COORDINATOR_MODEL=deepseek-chat
WB_SPECIALIST_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Let the assistant use each project's own uploads without a separate operator step
# (column names and summary numbers only; raw rows stay on the server). 0 = operator grants only.
WB_AGENT_AUTO_POLICY=1
# Optional US$ cap per project for automatic access; needs WB_AGENT_MODEL_PRICES. Blank = no cap.
WB_AGENT_AUTO_SPEND_CEILING_USD=
# JSON maps keyed by model ID. Supply reviewed ModelBound records;
# no default tokenizer assumption or pricing is inferred. See docs/agent-operator-guide.md.
WB_AGENT_MODEL_BOUNDS={}
WB_AGENT_MODEL_PRICES={}
WB_AGENT_LEASE_SECONDS=180
WB_AGENT_MAX_OUTPUT_TOKENS=1024
WB_PROVIDER_TIMEOUT_SECONDS=20
